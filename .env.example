# Copia este archivo a .env.local y complétalo. .env.local está en .gitignore:
# nunca subas credenciales reales al repositorio.
#
# Nota importante al clonar: TODO lo que define el país (regiones, encuadre del mapa,
# marca, idioma, funciones activas) vive en la carpeta `config/`, no aquí. Estas
# variables son solo credenciales y conmutadores de entorno.

# ── Qué país sirve este despliegue ───────────────────────────────────────────
# Debe coincidir con una clave de PRESETS en config/country.ts ("co", "ve", …).
# Si lo dejas vacío se usa DEFAULT_COUNTRY de ese mismo archivo.
NEXT_PUBLIC_COUNTRY=

# ── Qué ES este despliegue ───────────────────────────────────────────────────
# "hub" = helpmaps.net (portada de la red, documentación de la API, términos).
# Vacío o cualquier otro valor = una app de país (col.helpmaps.net).
NEXT_PUBLIC_MODE=

# ── Base de datos (Supabase) ─────────────────────────────────────────────────
# UN PROYECTO POR PAÍS. Es lo que garantiza que los datos de un país no se puedan
# leer desde otro: son bases distintas, no una regla que alguien pueda configurar mal.
# La anon key es pública por diseño; lo que protege los datos es RLS (ver db/).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: SALTA RLS por completo. Solo servidor, nunca en el navegador.
# Hoy no lo usa ninguna ruta; queda disponible para crear cuentas de staff.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sitio ────────────────────────────────────────────────────────────────────
# Solo si el dominio real difiere del `host` del preset (previews, desarrollo).
# Vacío → se usa https://<host del preset>.
NEXT_PUBLIC_SITE_URL=

# ── Límite de peticiones ─────────────────────────────────────────────────────
# Ponlo en "true" SOLO si el sitio está detrás de Cloudflare y CF-Connecting-IP
# es confiable. El limitador es en memoria: en un entorno serverless con varias
# instancias hace falta un almacén compartido o el firewall de la plataforma.
TRUST_CF_IP=false

# ── Correo (opcional pero recomendado) ───────────────────────────────────────
# Sin esto la app funciona igual: las sugerencias y las solicitudes de voluntariado
# quedan guardadas y el equipo las ve en /admin. Con esto, además llega un aviso al
# buzón del equipo en cuanto entran, que es la diferencia entre enterarse en minutos
# o cuando alguien se acuerde de abrir el panel.
#
# SMTP_PASS es lo único imprescindible: si falta, el módulo de correo no hace nada.
SMTP_HOST=mail.tudominio.net
SMTP_PORT=465          # 465 = TLS implícito · 587 = STARTTLS
SMTP_USER=info@tudominio.net
SMTP_PASS=
# Remitente mostrado. Por defecto "<marca> <SMTP_USER>".
SMTP_FROM=
# Buzón del equipo que recibe los avisos. Por defecto el de config/integrations.ts.
CONTACT_TO=



# ⚠️ Para que esos correos LLEGUEN a bandejas externas (Gmail y compañía) hace falta
# configurar SPF, DKIM y DMARC en el DNS del dominio. Un envío sin error en el log y
# que aun así no aparece es casi siempre esto, no un fallo del código.
#
# ⚠️ La app NUNCA escribe a una dirección que haya tecleado quien usa el formulario:
# solo al buzón fijo de arriba. Ver la nota sobre phishing en src/lib/email.ts.
